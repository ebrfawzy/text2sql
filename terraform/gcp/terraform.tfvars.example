# ── GCP Deployment Variables ────────────────────────────────────────
# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to version control.

gcp_project_id = "your-gcp-project-id"
gcp_region     = "us-central1"
environment    = "dev"
project_name   = "text2sql"

# ── LLM Configuration ──────────────────────────────────────────────
openai_api_key = "sk-your-api-key-here"
llm_model      = "gpt-4o-mini"

# ── Database ────────────────────────────────────────────────────────
db_uri = "sqlite:///example.db"
# db_uri = "postgresql://user:pass@/mydb?host=/cloudsql/project:region:instance"

# ── Cloud Run Settings ──────────────────────────────────────────────
cloud_run_cpu               = "2"
cloud_run_memory            = "1Gi"
cloud_run_min_instances     = 0      # 0 = scale to zero
cloud_run_max_instances     = 10
cloud_run_timeout_seconds   = 900    # 15 min
allow_unauthenticated       = true   # Set false for prod
