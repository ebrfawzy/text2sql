    "credit_template|bank_and_transactions|bank transaction frequency level (banktxfreq)": {
      "id": 43,
      "knowledge": "bank transaction frequency level (banktxfreq)",
      "description": "Categorical level of the bank transaction amount. Selects 34% of rows.",
      "definition": "banktxfreq = CASE WHEN banktxamt >= 9000 THEN 'High' WHEN banktxamt >= 5000 THEN 'Medium' ELSE 'Low' END",
      "type": "calculation_knowledge",
      "children_knowledge": -1,
      "tables": [
        "bank_and_transactions"
      ],
      "refuted": false
    },
    "credit_template|bank_and_transactions|overdraft frequency (ovrfreq)": {
      "id": 44,
      "knowledge": "overdraft frequency (ovrfreq)",
      "description": "Categorical frequency of overdrafts derived from bounced transaction count. Selects 28% of rows.",
      "definition": "ovrfreq = CASE WHEN bouncecount = 0 THEN 'Never' WHEN bouncecount <= 3 THEN 'Rare' WHEN bouncecount <= 7 THEN 'Occasional' ELSE 'Frequent' END",
      "type": "calculation_knowledge",
      "children_knowledge": -1,
      "tables": [
        "bank_and_transactions"
      ],
      "refuted": false
    },
    "credit_template|bank_and_transactions|insurance coverage level (inscoverage)": {
