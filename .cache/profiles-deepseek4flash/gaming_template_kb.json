    "gaming_template|interactionandcontrol|Haptic strength (hapstr)": {
      "id": 18,
      "knowledge": "Haptic strength (hapstr)",
      "description": "Haptic strength rating produced by haptic feedback level and vibration modes. Selects 6% of rows.",
      "definition": "hapstr = (CASE hapfeed WHEN 'Advanced' THEN 2 WHEN 'Basic' THEN 1 ELSE 0 END) * vibmodes",
      "type": "calculation_knowledge",
      "children_knowledge": -1,
      "tables": [
        "interactionandcontrol"
      ],
      "refuted": false
    },
    "gaming_template|interactionandcontrol|Trigger resolution (trigres)": {
      "id": 19,
      "knowledge": "Trigger resolution (trigres)",
      "description": "Trigger resolution derived from trigger travel distance and force feedback level. Selects 9% of rows.",
      "definition": "trigres = FLOOR(trigtravmm + 0.5) + (CASE forcefeed WHEN 'Advanced' THEN 1 WHEN 'Basic' THEN 0 ELSE -1 END)",
      "type": "calculation_knowledge",
      "children_knowledge": -1,
      "tables": [
        "interactionandcontrol"
      ],
      "refuted": false
    },
    "gaming_template|interactionandcontrol|Joystick precision (joyprec)": {
      "id": 20,
      "knowledge": "Joystick precision (joyprec)",
